# ---------------------------------------------
# VS Code theme extension (vsce / npm)
# ---------------------------------------------

# Packaged extension artifacts
*.vsix

# Node dependencies
node_modules/
jspm_packages/

# npm / yarn / pnpm logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# Lockfiles are intentionally kept for reproducible builds.
# Remove the lines below only if you do NOT want to track them.
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# vsce publishing artifacts
.vscode-test/
*.tgz

# ---------------------------------------------
# Environment / secrets
# (e.g. VSCE_PAT / OVSX_PAT for publishing)
# ---------------------------------------------
.env
.env.local
.env.*.local
*.pat

# ---------------------------------------------
# Editors / IDEs
# ---------------------------------------------
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ---------------------------------------------
# OS-generated files
# ---------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ---------------------------------------------
# Logs & temp
# ---------------------------------------------
*.log
tmp/
temp/
