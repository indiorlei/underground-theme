  "tokenColors": [
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6b737c"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#9db1c5"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.null",
        "variable.language.this",
        "support.type.primitive",
        "support.function",
        "support.variable.dom",
        "support.variable.property",
        "meta.property-name",
        "meta.property-value",
        "support.constant.handlebars"
      ],
      "settings": {
        "foreground": "#79b8ff"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#f97583"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "meta.function-call",
        "entity.other.attribute-name",
        "entity.name.function.shell"
      ],
      "settings": {
        "foreground": "#b392f0"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#9bd4b2"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "type": "#b392f0",
    "interface": "#b392f0",
    "enum": "#b392f0",
    "namespace": "#ffffffde",
    "function": "#b392f0",
    "method": "#b392f0",
    "property": "#ffffffde",
    "variable": "#ffffffde",
    "parameter": "#ffab70",
    "variable.readonly": "#79b8ff",
    "enumMember": "#79b8ff"
  }
}
