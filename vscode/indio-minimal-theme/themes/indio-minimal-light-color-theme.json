  "tokenColors": [
    {
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#BDBDBD"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#2b5581"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.null",
        "variable.language.this",
        "support.type.primitive",
        "support.function",
        "support.variable.dom",
        "support.variable.property",
        "meta.property-name",
        "meta.property-value",
        "support.constant.handlebars"
      ],
      "settings": {
        "foreground": "#1976D2"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D32F2F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "meta.function-call",
        "entity.other.attribute-name",
        "entity.name.function.shell"
      ],
      "settings": {
        "foreground": "#6f42c1"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#22863a"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "type": "#6f42c1",
    "interface": "#6f42c1",
    "enum": "#6f42c1",
    "namespace": "#212121",
    "function": "#6f42c1",
    "method": "#6f42c1",
    "property": "#212121",
    "variable": "#212121",
    "parameter": "#FF9800",
    "variable.readonly": "#1976D2",
    "enumMember": "#1976D2"
  }
}
